<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Liste des projets | AMES</title>
    <link rel="stylesheet" href="/projects-list.css">
    <link rel="shortcut icon" href="/Img/logoN.png">
</head>
<body>
    <header>
        <div class="header-container">
            <div class="logo">
                <a href="/"><img src="./Img/logo.png" alt="AMES"></a>
            </div>
            <nav>
                <ul>
                    <li><a href="http://www.ames-pro.fr/">Accueil</a></li>
                    <li><a href="https://ames-pro.vercel.app/projects-list">Planification</a></li>
                    <li><a href="https://ames-pro.vercel.app/contact">Contact</a></li>
                    <li><a href="https://ames-pro.vercel.app/logout" class="log" id="log"><i class="fas fa-user"></i></a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main>
        <section class="main-section">
            <div class="projects-container">
                <h1>Projets de planification</h1>
                
                <div id="add-project">
                    <input type="text" id="newProject" placeholder="Nom du nouveau projet">
                    <button id="addProject">
                        <span>+</span> Ajouter
                    </button>
                </div>

                <ul class="projects-list">
                    <% for(let i = 0; i < name.length; i++){ %>
                        <div class="project-item">
                            <img src="/Img/supprimer.png" alt="Supprimer" id="<%= name[i] %>" class="delete-icon">
                            <a href="/projects-list/<%= name[i] %>" class="project-link">
                                <%= name[i] %>
                            </a>
                        </div>
                    <% } %>
                </ul>
            </div>
        </section>    
    </main>


    <script src="JavaScript/projects-list.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</body>
</html>
